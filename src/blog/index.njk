---
layout: blog
---
<h1>Blog Posts</h1>

<!-- Organize posts in reverse order from date (or creation?) this allows better formatting so most recent is at the top -->
{% for post in collections.post | reverse %}
<!-- Title for each post and correlated with it's creation date -->
<h2><a href="{{post.url}}"> {{ post.data.title}} </a> - {{post.date | readableDate}} </h2>
<p>{{post.data.excerpt}}</p>
{% endfor %}

